# 本地配置模板 — 复制为 local.yaml 并填入实际凭据
# ⚠️ local.yaml 已在 .gitignore 中, 不会被提交
# 也可通过 MF_MYSQL_*、MF_DDB_*、MF_PARQUET_ROOT 环境变量设置

data:
  source: parquet_futures
  mysql:
    host: 'mysql.example.internal'
    port: 3306
    user: 'your_username'
    password: 'your_password'
    database: 'futures'
  parquet:
    root_path: 'E:\\path\\to\\local\\futures-parquet'
  ddb:
    host: 'ddb.example.internal'
    port: 8961
    user: 'your_username'
    password: 'your_password'
