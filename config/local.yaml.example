# 本机数据运行时模板 — 复制为 local.yaml 后填写路径与认证 release。
# local.yaml 已在 .gitignore 中，不能覆盖品种、因子、处理或回测语义。

data:
  source: duckdb_futures
  parquet:
    root_path: 'E:\\path\\to\\local\\futures-parquet'
  duckdb:
    path: 'E:\\path\\to\\local\\futures_data.duckdb'
    required_release_id: ''
    result_backend: pandas
